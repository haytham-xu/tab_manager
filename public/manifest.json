{
  "manifest_version": 3,
  "name": "Tab Manager",
  "version": "0.3.11",
  "description": "Local-first tab topics, archives and exact-URL reuse. No server or account required.",
  "permissions": ["tabs", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Tab Manager", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}